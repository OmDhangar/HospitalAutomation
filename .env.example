# --------------------------------------------------------------- database ---
# Two connection strings to the SAME managed Postgres database, as two roles.
# The split is a security control, not a convention: row-level security is what
# keeps hospitals from seeing each other's patients, and it only applies to a
# role that cannot bypass it.
#
# Setup, once per database:
#   1. Create the database with your provider and copy its connection string
#      into DATABASE_ADMIN_URL below (the built-in owner/admin user).
#   2. Choose a strong password and put it in APP_DB_PASSWORD.
#   3. npm run db:bootstrap    - creates the restricted app role and verifies
#                                that the privilege split is actually in place
#   4. Set DATABASE_URL to the same host/database as the admin URL, but with
#      the app role and APP_DB_PASSWORD.
#   5. npm run db:migrate
#
# Pick a region close to your hospitals. For Indian healthcare data, prefer
# Mumbai (ap-south-1) or Singapore over a default US/EU region.
#
# On Neon specifically:
#   - Use the DIRECT (non-pooled) connection string for DATABASE_ADMIN_URL.
#     Schema migrations through the PgBouncer endpoint can misbehave.
#   - The POOLED string (host contains "-pooler") is right for DATABASE_URL.
#     It is safe here only because withTenant() sets app.hospital_id with
#     set_config(..., true), which is transaction-local. A session-level SET
#     would leak one hospital's context onto the next request sharing that
#     pooled connection.
#   - Both strings need sslmode=require, which Neon already includes.

# Provider's owner/admin role (Neon: neondb_owner). Runs migrations and the
# cross-tenant worker. Must be able to bypass RLS. Never serves a web request.
DATABASE_ADMIN_URL=

# The restricted role the web application connects as. Must NOT bypass RLS.
DATABASE_URL=

# Used by db:bootstrap to create the app role above. Must match DATABASE_URL.
APP_DB_ROLE=opd_app
APP_DB_PASSWORD=

# --------------------------------------------------------------- whatsapp ---
# Meta WhatsApp Cloud API (direct integration, no BSP).
# From Meta → WhatsApp → API Setup. Also settable per hospital in the UI.
WHATSAPP_PHONE_NUMBER_ID=
# A permanent System User token. NOT the 24-hour temporary token.
WHATSAPP_ACCESS_TOKEN=
# Any string you invent; entered identically in Meta's webhook configuration.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta → App Settings → Basic → App Secret. Without it the webhook rejects
# every request, which is the correct failure mode but a confusing one.
WHATSAPP_APP_SECRET=
# WhatsApp Business Account id, used only by `npm run whatsapp:templates`.
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Shared secret protecting POST /api/internal/tick, which drains the outbox.
INTERNAL_TICK_SECRET=

# ------------------------------------------------------------------- app ---
# Base URL used to build patient queue links.
PUBLIC_BASE_URL=http://localhost:3000
